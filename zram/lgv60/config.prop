# ZRAM for LG V60 —— 用户配置
# 改完保存，重启生效；也可在 KernelSU 管理器里点模块的“操作”按钮立即应用。

# 压缩算法。内核需先包含该算法，可用值见：
#   cat /sys/block/zram0/comp_algorithm
# stock 内核: lzo lz4 lz4hc zstd
# 刷了含 lz4kd 的构建后额外可用: lz4kd
ZRAM_ALGO=lz4kd

# zram 大小（字节）。默认 4294967296 = 4 GiB。
# 留空 = 沿用 ROM 当前大小（V60 原值约 3.73 GiB），只换算法。
# 常用值：4294967296(4G) 6442450944(6G) 8589934592(8G)
ZRAM_SIZE=4294967296

# swap 优先级。留空 = 沿用当前优先级。V60 ROM 默认 -2。
# 注意：toybox 的 swapon 不接受负数优先级；单个 swap 设备时优先级无意义，
# 脚本会自动退化为不带 -p 的默认优先级。
SWAP_PRIORITY=-2

# 压缩流数量。ROM 默认 8。
MAX_COMP_STREAMS=8

# 等待 sys.boot_completed=1 的最长秒数（service.sh 用；"--now" 模式跳过等待）。
BOOT_WAIT_SECONDS=120
